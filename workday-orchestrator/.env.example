# Workday orchestrator settings. Copy to .env and fill in; never commit .env.

# Required: the key Copilot Studio's connection sends as X-API-Key (at least 32 characters: openssl rand -hex 32)
WORKDAY_API_KEY=
# Where runs, jobs and deliverables are stored
WORKDAY_ROOT=data
# Public HTTPS base of this server (board and file links point here)
WORKDAY_PUBLIC_BASE=https://workday.example.com
# Input files copied into each run, and the notes answer key (python fixtures/make_fixtures.py inbox --truth truth)
WORKDAY_INBOX=inbox
# Answer key for the notes verifier
WORKDAY_TRUTH_DIR=truth
# Python with pandas, openpyxl, python-docx, python-pptx, matplotlib for the agents
WORKDAY_PYTHON=python3

# Agent commands; the mission prompt arrives on stdin (POSIX quoting; forward slashes on Windows)
WORKDAY_CLAUDE_CMD="claude --print --permission-mode bypassPermissions"
WORKDAY_CODEX_CMD="codex exec --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check -"

# Power Platform missions only (pp_tables, pp_app, pp_flows). Use a demo or sandbox environment.
DV_ORG=https://yourorg.crm.dynamics.com
DV_ENV_ID=
WORKDAY_DV=dv
WORKDAY_PP_ENV_ID=
WORKDAY_PP_LOGIN_HINT=
WORKDAY_PROTECTED_APP_IDS=
WORKDAY_CANVAS_SKILLS=canvas-skills/references
WORKDAY_CANVAS_DIR_HOST=canvas
WORKDAY_CANVAS_DIR_MCP=canvas
# Optional shared-screen lock command: `<cmd> try|release "<run> <mission>"`, exit 0 = ok
WORKDAY_DESK_LOCK_CMD=
