# dev-tools settings (deploy/install.sh writes /opt/devtools/.env with fresh keys). Never commit real values.

# Key for the Copilot Studio MCP connection (x-api-key), at least 32 characters
DEVTOOLS_API_KEY=
# Key sub-agents use to call back into the same tools, different from the above, at least 32 characters
DEVTOOLS_SUB_KEY=
DEVTOOLS_PORT=8095
# Public host name(s) of your reverse proxy, space separated (DNS-rebinding protection)
DEVTOOLS_PUBLIC_HOSTS=
# GitHub repos (owner/name, space separated) the push tool may push to
DEVTOOLS_GITHUB_REPOS=
# Root-only file holding ANTHROPIC_API_KEY=... for sub-agents (read at call time)
DEVTOOLS_CLAUDE_ENV=/opt/devtools/claude.env
# File holding a GitHub token used host-side to open pull requests (never enters the sandbox)
DEVTOOLS_GITHUB_TOKEN_FILE=/opt/devtools/secrets/github_token
# Unprivileged host user that runs sub-agents
DEVTOOLS_SUBAGENT_USER=devtools
DEVTOOLS_SUBAGENT_MODEL=sonnet
# Optional: minimum seconds per call, to stay under Copilot Studio's tool-call rate limit
DEVTOOLS_MIN_CALL_S=0
