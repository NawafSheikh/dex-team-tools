# Training video service settings. Never commit real values.
TV_PORT=8913
TV_HOST=127.0.0.1
# Public HTTPS base (video links and /openapi.json host come from it)
TV_PUBLIC_BASE=https://your-host.example.com/tv
# Files holding the service API key (x-api-key) and the Gemini API key, or set TV_GEMINI_KEY directly
TV_API_KEY_FILE=state/api-key
TV_GEMINI_KEY_FILE=state/gemini-key
TV_TTS_MODEL=gemini-3.8-flash-tts
TV_MUSIC_MODEL=lyria-3.5
# Optional music file used if Lyria fails (empty: a silent bed)
TV_FALLBACK_BED=
TV_RENDER_QUALITY=standard
TV_RENDER_WORKERS=2
TV_RENDERS_PER_HOUR=12
TV_VIDEO_TTL_DAYS=30
# Optional shared-host lock (flock file); renders wait while another owner holds it
TV_DESK_LOCK=
TV_DESK_OWNER=
TV_DESK_NAME=train-video
